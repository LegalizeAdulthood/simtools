{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "sibling-build-preset",
      "hidden": true,
      "description": "Use a sibling directory for the build based on the preset name",
      "binaryDir": "${sourceDir}/../build-${sourceDirName}-${presetName}"
    },
    {
      "name": "project-name",
      "hidden": true,
      "description": "Set the project name from the preset name",
      "cacheVariables": {
        "PROJECT_NAME": "OpenSIMH Tools ${presetName}"
      }
    },
    {
      "name": "vcpkg",
      "hidden": true,
      "description": "Configure the toolchain for vcpkg",
      "toolchainFile": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "debug-build",
      "hidden": true,
      "description": "Set the build type to Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release-build",
      "hidden": true,
      "description": "Set the build type to Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "default",
      "displayName": "Configure with default settings",
      "inherits": [ "sibling-build-preset", "vcpkg", "project-name", "debug-build" ]
    },
    {
      "name": "release",
      "displayName": "Configure with release settings",
      "inherits": [ "sibling-build-preset", "vcpkg", "project-name", "release-build" ]
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "displayName": "Build with default settings",
      "configurePreset": "default",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "displayName": "Build with release settings",
      "configurePreset": "release",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "displayName": "Test with default settings",
      "configurePreset": "default",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "displayName": "Test with release settings",
      "configurePreset": "release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "packagePresets": [
    {
      "name": "default",
      "displayName": "Package with default settings",
      "configurePreset": "default",
      "configurations": [ "Debug" ]
    },
    {
      "name": "release",
      "displayName": "Package with release settings",
      "configurePreset": "release",
      "configurations": [ "Release" ]
    }
  ],
  "workflowPresets": [
    {
      "name": "default",
      "displayName": "Workflow with default settings: configure, build and test",
      "steps": [
        {
          "type": "configure",
          "name": "default"
        },
        {
          "type": "build",
          "name": "default"
        },
        {
          "type": "test",
          "name": "default"
        }
      ]
    },
    {
      "name": "release",
      "displayName": "Workflow with release settings: configure, build, test and package",
      "steps": [
        {
          "type": "configure",
          "name": "release"
        },
        {
          "type": "build",
          "name": "release"
        },
        {
          "type": "test",
          "name": "release"
        },
        {
          "type": "package",
          "name": "release"
        }
      ]
    }
  ]
}
